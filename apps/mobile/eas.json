{
  "cli": {
    "version": ">= 14.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "env": {
        "GOOGLE_IOS_URL_SCHEME": "com.googleusercontent.apps.692754456856-5g4te7hf8do0k0an5c502evi2qshv8fh",
        "EXPO_PUBLIC_PROJECT_ID": "dc228f01-efda-4fc0-a714-6d455f6461e6"
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_ENV": "development"
      }
    },
    "staging": {
      "extends": "base",
      "distribution": "internal",
      "channel": "staging",
      "env": {
        "EXPO_PUBLIC_ENV": "staging"
      }
    },
    "preview": {
      "extends": "staging",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "extends": "base",
      "distribution": "store",
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_ENV": "production"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "production-apk": {
      "extends": "production",
      "environment": "production",
      "distribution": "internal",
      "channel": "production-apk",
      "autoIncrement": false,
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "chaching@chachinggaming.com",
        "ascAppId": "6768984349",
        "appleTeamId": "YDPPPHLB3D"
      },
      "android": {
        "track": "internal"
      }
    }
  }
}
