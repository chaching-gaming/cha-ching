{
  "name": "cha-ching",
  "version": "1.0.0",
  "private": true,
  "description": "Cha-Ching fintech mobile app monorepo",
  "scripts": {
    "lint": "eslint . --ext .ts,.tsx --ignore-path .gitignore",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "typecheck": "pnpm -r run typecheck",
    "db:gen-types": "supabase gen types typescript --local > packages/types/src/database.ts"
